 //T-estados a 3.5 MHz por cada unidad del prescaler: 875 kHz es 3.5 MHz / 4
 #define DATAGEAR_ZXN_PRESCALAR_TSTATES 4
 
+//READ-BACK. Which registers a read sequence returns (WR6 0xBB, read mask
+//follows: bit 0 status, 1-2 byte counter, 3-4 port A address, 5-6 port B
+//address), where the sequence is, whether one is pending at all, and the
+//two facts the status byte reports: bytes transferred since the last LOAD or
+//CONTINUE, and whether the block has completed at least once since then.
+//A read of the port with nothing pending returns the status byte.
+z80_byte datagear_read_mask=0x7F;   //at power up the read mask is 0x7f
+z80_byte datagear_read_pending=0;   //1 = a read sequence, 2 = the status byte once
+int datagear_read_index=0;          //which bit of the mask comes next
+z80_int datagear_bytes_done=0;
+z80_byte datagear_block_done=0;
 
+
 //
 // Fin variables que hay que guardar en un snapshot
 //
@@ -126,8 +138,53 @@
     datagear_wr0=datagear_wr1=datagear_wr2=datagear_wr3=datagear_wr4=datagear_wr5=datagear_wr6=0;
     datagear_is_dma_transfering.v=0;
 
+    datagear_read_mask=0x7F;
+    datagear_read_pending=0;
+    datagear_read_index=0;
+    datagear_bytes_done=0;
+    datagear_block_done=0;
+}
+//Status byte, 00E1101T: E clear once the block has completed at least once
+//since LOAD or CONTINUE, T set once a byte has moved since then.
+z80_byte datagear_status_byte(void)
+{
+    z80_byte st=0x1A;
+    if (!datagear_block_done) st|=0x20;
+    if (datagear_bytes_done) st|=0x01;
+    return st;
+}
+
+//A read of the DMA port. With a read sequence pending, the next register the
+//mask names, looping round at the end; with the status byte pending, that,
+//once; with nothing pending, the status byte.
+z80_byte datagear_read_port(void)
+{
+    if (datagear_read_pending==2) {
+        datagear_read_pending=0;
+        return datagear_status_byte();
+    }
+    if (datagear_read_pending==1 && (datagear_read_mask & 0x7F)) {
+        int tries=7;
+        while (tries--) {
+            int bit=datagear_read_index;
+            datagear_read_index=(datagear_read_index+1)%7;
+            if (datagear_read_mask & (1<<bit)) {
+                switch (bit) {
+                    case 0: return datagear_status_byte();
+                    case 1: return value_16_to_8l(datagear_bytes_done);
+                    case 2: return value_16_to_8h(datagear_bytes_done);
+                    case 3: return datagear_port_a_start_addr_low;
+                    case 4: return datagear_port_a_start_addr_high;
+                    case 5: return datagear_port_b_start_addr_low;
+                    case 6: return datagear_port_b_start_addr_high;
+                }
+            }
+        }
+    }
+    return datagear_status_byte();
 }
 
